  },
  night: {
    wallColor: 'linear-gradient(to bottom, #080610, #0a0814)',
    floorColor: 'linear-gradient(to top, #080606, #0a0810)',
    lightColor: '#a29bfe',
    lightShadow: '0 0 10px 4px rgba(162,155,254,0.4), 0 0 30px 10px rgba(108,92,231,0.3)',
    coneColor: 'rgba(162,155,254,0.03)',
    ambientColor: 'radial-gradient(ellipse 70% 50% at 50% 20%, rgba(108,92,231,0.08), transparent 70%)',
    blindsOpen: 0.1,
    lampOn: false,
    temp: '20°C',
    kelvin: '1800K',
    tempNum: 20,
    statusLights: 'Deep Amber · 1800K',
    statusTemp: '20°C · Sleep Mode',
    statusBlinds: 'Blinds · 10% Open',
    statusDevices: '2 Devices Active',
    sofaColor: 'linear-gradient(to bottom, #151020, #100c18)',
    heroAmbient: 'radial-gradient(ellipse 80% 60% at 50% 60%, rgba(108,92,231,0.06) 0%, transparent 70%)',
    miMode: 'Night',
    miTemp: '20°C · 1800K',
    tvOn: false,
    deskLamp: false,
    musicBars: false,
    thermoColor: 'conic-gradient(#a29bfe 0%, transparent 60%)',
  }
};

function setScene(name) {
  if (partyInterval) { clearInterval(partyInterval); partyInterval = null; }
  currentScene = name;
  const s = scenes[name];

  // Buttons
  document.querySelectorAll('.scene-btn').forEach(b => b.classList.remove('active'));
  document.querySelector(`.btn-${name}`)?.classList.add('active');

  // Walls & floor
  document.getElementById('wallBack').style.background = s.wallColor;
  document.getElementById('wallLeft').style.background = s.wallColor.replace('bottom', 'right');
  document.getElementById('wallRight').style.background = s.wallColor.replace('bottom', 'left');
  document.getElementById('roomFloor').style.background = s.floorColor;

  // Ceiling light
  const ceilAfter = document.getElementById('ceilingLight');
  ceilAfter.style.setProperty('--light-color', s.lightColor);
  document.documentElement.style.setProperty('--warm', s.lightColor);
  // Hack: update shadow via a style tag
  updateCeilingLight(s.lightColor, s.lightShadow, s.coneColor);

  // Ambient
  document.getElementById('roomAmbient').style.background = s.ambientColor;
  document.getElementById('heroAmbient').style.background = s.heroAmbient;

  // Blinds
  const slats = document.querySelectorAll('.blind-slat');
  const open = s.blindsOpen;
  slats.forEach((sl, i) => {
    const tiltDeg = open * 85;
    sl.style.transform = `rotateX(${tiltDeg}deg)`;
    sl.style.background = open > 0.5
      ? `rgba(${20+open*100},${18+open*80},${open*40},${1-open*0.5})`
      : '#1a1a2a';
  });
  // Window light beam
  document.getElementById('windowBeam').style.background =
    open > 0.3 ? `linear-gradient(to bottom, rgba(255,220,${120+open*100},${open*0.4}), transparent)` : 'none';

  // Floor lamp
  const lampGlow = document.getElementById('lampGlow');
  const lampShade = document.getElementById('lampShade');
  lampGlow.style.opacity = s.lampOn ? '1' : '0';
  lampShade.style.background = s.lampOn
    ? 'linear-gradient(to bottom, #3a2f48, rgba(255,180,60,0.3))'
    : 'linear-gradient(to bottom, #2a2530, #1a1520)';
  if (s.lampOn) {
    lampShade.style.setProperty('--after-opacity', '1');
    lampShade.style.boxShadow = `0 0 15px rgba(255,180,60,0.4)`;
  } else {
    lampShade.style.boxShadow = 'none';
  }

  // Sofa color
  document.getElementById('sofaBody').style.background = s.sofaColor;

  // Desk lamp (focus)
  document.getElementById('deskLamp').style.opacity = s.deskLamp ? '1' : '0';

  // Music bars (party)
  const musicBars = document.getElementById('musicBars');
  musicBars.style.opacity = s.musicBars ? '1' : '0';
  const mbArr = musicBars.querySelectorAll('.music-bar');
  if (s.musicBars) {
    const partyColors = ['#fd79a8','#00cec9','#a29bfe','#fd79a8','#74b9ff','#ffeaa7','#fd79a8','#00cec9','#a29bfe','#ffd32a','#ff7979','#00b894'];
    mbArr.forEach((mb, i) => {
      mb.style.background = partyColors[i % partyColors.length];
      mb.style.animation = `dance${(i%5)+1} ${0.3+Math.random()*0.4}s ease-in-out infinite`;
    });
    partyInterval = setInterval(partyStrobe, 500);
  } else {
    mbArr.forEach(mb => mb.style.animation = 'none');
    document.getElementById('partyStrobe').style.opacity = '0';
  }

  // Thermostat
  document.getElementById('thermoRing').style.background = s.thermoColor;
  document.getElementById('thermoTemp').textContent = s.tempNum + '°';

  // Status bar
  document.getElementById('statusLights').textContent = s.statusLights;
  document.getElementById('statusTemp').textContent = s.statusTemp;
  document.getElementById('statusBlinds').textContent = s.statusBlinds;
  document.getElementById('statusDevices').textContent = s.statusDevices;

  // Mode indicator
  document.getElementById('miMode').textContent = s.miMode;
  document.getElementById('miTemp').textContent = s.miTemp;
  document.getElementById('modeIndicator').style.borderColor = `rgba(${hexToRgb(s.lightColor) || '212,168,83'},0.4)`;
  document.getElementById('miMode').style.color = s.lightColor;
}

function hexToRgb(hex) {
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);
  return `${r},${g},${b}`;
}

function updateCeilingLight(color, shadow, coneColor) {
  // Dynamic style injection for ::after pseudo
  let st = document.getElementById('dynamic-light-style');
  if (!st) { st = document.createElement('style'); st.id = 'dynamic-light-style'; document.head.appendChild(st); }
  st.textContent = `
    .ceiling-light::after {
      background: ${color} !important;
      box-shadow: ${shadow} !important;
    }
    .light-cone {
      border-top-color: ${coneColor} !important;
    }
  `;
}

let partyColorIndex = 0;
const partyColorSets = [
  { bg: 'rgba(253,121,168,0.05)', light: '#fd79a8' },
  { bg: 'rgba(0,206,201,0.05)', light: '#00cec9' },
  { bg: 'rgba(162,155,254,0.05)', light: '#a29bfe' },
  { bg: 'rgba(255,232,75,0.04)', light: '#ffd32a' },
];
function partyStrobe() {
  const cs = partyColorSets[partyColorIndex % partyColorSets.length];
  partyColorIndex++;
  document.getElementById('partyStrobe').style.cssText = `
    background: ${cs.bg}; opacity: 0.8; transition: opacity 0.15s;
  `;
  setTimeout(() => { document.getElementById('partyStrobe').style.opacity = '0'; }, 150);
  updateCeilingLight(cs.light,
    `0 0 20px 8px ${cs.light}, 0 0 60px 20px ${cs.light}88`,
    `${cs.bg}`);
  document.getElementById('thermoRing').style.background = `conic-gradient(${cs.light} 0%, transparent 60%)`;
}

// ── DIMMER CONTROLS ──
function updateDimmer() {
  const val = document.getElementById('brightnessSlider').value;
  const blob = document.getElementById('dimmerBlob');
  const bulb = document.getElementById('dimmerBulb');
  const warm = document.getElementById('warmSlider').value;
  const cool = document.getElementById('coolSlider').value;
  const ratio = warm / (warm + cool + 0.01);
  const r = Math.round(255 * ratio + 116 * (1-ratio));
  const g = Math.round(180 * ratio + 185 * (1-ratio));
  const b = Math.round(50 * ratio + 255 * (1-ratio));
  const opacity = val / 100;
  blob.style.background = `radial-gradient(ellipse at 50% 0%, rgba(${r},${g},${b},${opacity*0.6}), transparent 70%)`;
  blob.style.opacity = opacity;
  bulb.style.background = `rgb(${r},${g},${b})`;
  bulb.style.boxShadow = `0 0 ${val/10}px ${val/20}px rgb(${r},${g},${b}), 0 0 ${val/4}px ${val/8}px rgba(${r},${g},${b},0.5)`;
  document.getElementById('brightnessVal').textContent = `Brightness · ${val}%`;
  const kelvin = Math.round(2700 + (6500-2700) * cool/100);
  document.getElementById('tempVal').textContent = `Color Temp · ${kelvin}K`;
}
function updateColorTemp() { updateDimmer(); }

// ── SCROLL ANIMATIONS ──
const fadeEls = document.querySelectorAll('.fade-up');
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.15 });
fadeEls.forEach(el => io.observe(el));

// ── SCROLL: hero ambient parallax ──
window.addEventListener('scroll', () => {
  const scrollY = window.scrollY;
  const hero = document.getElementById('heroAmbient');
  hero.style.transform = `translateY(${scrollY * 0.3}px)`;
});

// ── DRAG SCROLL FOR PROJECTS ──
const scroller = document.getElementById('projectsScroller');
let isDown = false, startX, scrollLeft;
scroller.addEventListener('mousedown', e => {
  isDown = true; scroller.style.cursor = 'grabbing';
  startX = e.pageX - scroller.offsetLeft;
  scrollLeft = scroller.scrollLeft;
});
scroller.addEventListener('mouseleave', () => { isDown = false; scroller.style.cursor = 'grab'; });
scroller.addEventListener('mouseup', () => { isDown = false; scroller.style.cursor = 'grab'; });
scroller.addEventListener('mousemove', e => {
  if (!isDown) return;
  e.preventDefault();
  const x = e.pageX - scroller.offsetLeft;
  scroller.scrollLeft = scrollLeft - (x - startX) * 1.2;
});

// ── HOVER: room elements ──
document.querySelectorAll('.service-card, .scene-btn, .project-card').forEach(el => {
  el.addEventListener('mouseenter', () => {
    cursor.style.width = '24px'; cursor.style.height = '24px';
    ring.style.width = '50px'; ring.style.height = '50px';
  });
  el.addEventListener('mouseleave', () => {
    cursor.style.width = '12px'; cursor.style.height = '12px';
    ring.style.width = '36px'; ring.style.height = '36px';
  });
});

// ── ROOM HOVER: subtle ambient light follow ──
const roomStage = document.getElementById('roomStage');
roomStage.addEventListener('mousemove', e => {
  const rect = roomStage.getBoundingClientRect();
  const x = ((e.clientX - rect.left) / rect.width) * 100;
  const y = ((e.clientY - rect.top) / rect.height) * 100;
  document.getElementById('roomAmbient').style.background =
    `radial-gradient(ellipse 50% 40% at ${x}% ${y}%, ${getSceneAmbientColor()}, transparent 70%)`;
});
roomStage.addEventListener('mouseleave', () => {
  const s = scenes[currentScene];
  document.getElementById('roomAmbient').style.background = s.ambientColor;
});

function getSceneAmbientColor() {
  const colors = {
    relax: 'rgba(255,159,67,0.15)',
    focus: 'rgba(116,185,255,0.12)',
    party: 'rgba(253,121,168,0.2)',
    morning: 'rgba(255,234,167,0.12)',
    night: 'rgba(108,92,231,0.1)'
  };
  return colors[currentScene] || 'rgba(255,159,67,0.12)';
}

// ── INIT ──
setScene('relax');
updateDimmer();

// Music bar random heights on party
setInterval(() => {
  if (currentScene !== 'party') return;
  document.querySelectorAll('.music-bar').forEach(b => {
    const h = 3 + Math.random() * 18;
    b.style.height = h + 'px';
  });
}, 120);
</script>
</body>
</html>
