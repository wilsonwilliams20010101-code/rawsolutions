    statusBlinds: 'Blinds · Fully Open',
    statusDevices: '5 Devices Active',
    sofaColor: 'linear-gradient(to bottom, #241f1a, #1a1610)',
    heroAmbient: 'radial-gradient(ellipse 80% 60% at 50% 60%, rgba(255,234,167,0.1) 0%, transparent 70%)',
