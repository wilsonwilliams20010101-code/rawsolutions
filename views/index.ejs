  },
  focus: {
    wallColor: 'linear-gradient(to bottom, #0e0f1e, #10122a)',
    floorColor: 'linear-gradient(to top, #0e100a, #0f1018)',
    lightColor: '#b8d8ff',
    lightShadow: '0 0 20px 8px #74b9ff, 0 0 60px 20px rgba(116,185,255,0.6)',
    coneColor: 'rgba(116,185,255,0.08)',
    ambientColor: 'radial-gradient(ellipse 70% 50% at 50% 20%, rgba(116,185,255,0.1), transparent 70%)',
    blindsOpen: 0.85,
    lampOn: false,
    temp: '21°C',
    kelvin: '6500K',
    tempNum: 21,
    statusLights: 'Cool White · 6500K',
    statusTemp: '21°C · Ventilation On',
    statusBlinds: 'Blinds · 85% Open',
    statusDevices: '6 Devices Active',
    sofaColor: 'linear-gradient(to bottom, #1e2030, #151828)',
    heroAmbient: 'radial-gradient(ellipse 80% 60% at 50% 60%, rgba(116,185,255,0.08) 0%, transparent 70%)',
    miMode: 'Focus',
    miTemp: '21°C · 6500K',
    tvOn: false,
    deskLamp: true,
    musicBars: false,
    thermoColor: 'conic-gradient(#74b9ff 0%, transparent 60%)',
  },
  party: {
    wallColor: 'linear-gradient(to bottom, #150a15, #1a0a1a)',
    floorColor: 'linear-gradient(to top, #100a14, #0e0812)',
    lightColor: '#fd79a8',
    lightShadow: '0 0 20px 8px #fd79a8, 0 0 60px 20px rgba(253,121,168,0.8)',
    coneColor: 'rgba(253,121,168,0.15)',
    ambientColor: 'radial-gradient(ellipse 70% 50% at 50% 20%, rgba(253,121,168,0.15), transparent 70%)',
    blindsOpen: 0,
