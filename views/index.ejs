    heroAmbient: 'radial-gradient(ellipse 80% 60% at 50% 60%, rgba(253,121,168,0.12) 0%, transparent 70%)',
    miMode: 'Party 🎉',
    miTemp: '22°C · RGBW',
    tvOn: false,
    deskLamp: false,
    musicBars: true,
    thermoColor: 'conic-gradient(#fd79a8 0%, transparent 60%)',
  },
  morning: {
    wallColor: 'linear-gradient(to bottom, #12100e, #1a1610)',
    floorColor: 'linear-gradient(to top, #1e1a10, #16140c)',
    lightColor: '#ffeaa7',
    lightShadow: '0 0 20px 8px #ffeaa7, 0 0 60px 20px rgba(255,234,167,0.5)',
    coneColor: 'rgba(255,234,167,0.06)',
    ambientColor: 'radial-gradient(ellipse 70% 50% at 50% 20%, rgba(255,234,167,0.1), transparent 70%)',
    blindsOpen: 1,
    lampOn: false,
    temp: '25°C',
    kelvin: '4000K',
    tempNum: 25,
    statusLights: 'Natural Light · 4000K',
